<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and device transfer. The encrypted Claude key never leaves the device (spec §9). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
