    <issue id="HardcodedText" severity="error" />
    <issue id="ComposeHardcodedText" severity="error" />
    <!-- targetSdk 36 is deliberate (spec §0 A4); version pins are chosen in gradle/libs.versions.toml. -->
    <issue id="OldTargetApi" severity="ignore" />
    <issue id="GradleDependency" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <!-- Strings in data/res are curated content; some are kept for P1 screens that don't exist yet. -->
    <issue id="UnusedResources" severity="ignore" />
    <issue id="MissingTranslation" severity="ignore" />
    <issue id="Typos" severity="ignore" />
</lint>
