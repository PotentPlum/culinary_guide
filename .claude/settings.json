{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(./gradlew *)",
      "Bash(gradle *)",
      "Bash(python3 tools/validate_data.py*)",
      "Bash(find *)",
      "Bash(ls*)",
      "Bash(grep*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in */data/*) python3 \"$CLAUDE_PROJECT_DIR/tools/validate_data.py\" >&2 || exit 2;; esac"
          }
        ]
      }
    ]
  }
}
