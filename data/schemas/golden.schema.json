{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "golden.schema.json",
  "title": "Recipe ingestion golden fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "description", "cases"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "description": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test", "fn", "args"],
        "minProperties": 4,
        "maxProperties": 4,
        "properties": {
          "test": { "type": "string", "minLength": 1 },
          "fn": {
            "enum": [
              "parseIso8601Duration", "cleanText", "stripHtml", "extractJsonLdBlocks", "findRecipeNode",
              "isIngredientHeader", "parseIngredientSections", "parseInstructionSections",
              "extractWprmIngredients", "ingestRecipeFromHtml"
            ]
          },
          "args": { "type": "array" },
          "result": {},
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "code"],
            "properties": {
              "name": { "type": "string" },
              "code": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}
