{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Curriculum index: stages, courses, modules, lesson and exercise titles, competencies (generated by tools/export_curriculum.py)",
  "type": "object",
  "required": [
    "schemaVersion",
    "stages",
    "courses",
    "competencies"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "enum": [
        1
      ]
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "titleNl",
          "question",
          "courseIds"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S\\d$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "titleNl": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "courseIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "courses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "stage",
          "kind",
          "title",
          "hours",
          "purpose",
          "prerequisites",
          "status",
          "hasContent",
          "safetyItems",
          "safetyItemsRead",
          "modules",
          "rubric"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^([A-Z]{3}-\\d|MS-S\\d)$"
          },
          "stage": {
            "type": "string",
            "pattern": "^S\\d$"
          },
          "kind": {
            "enum": [
              "COURSE",
              "MILESTONE",
              "CAPSTONE"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "hours": {
            "type": "number",
            "minimum": 0
          },
          "purpose": {
            "type": "string"
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "DRAFT",
              "FINAL",
              null
            ]
          },
          "hasContent": {
            "type": "boolean"
          },
          "safetyItems": {
            "type": "integer",
            "minimum": 0
          },
          "safetyItemsRead": {
            "type": "integer",
            "minimum": 0
          },
          "modules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "hours",
                "lessons",
                "exercises",
                "checkItems",
                "safetyCheckItems"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "hours": {
                  "type": "number",
                  "minimum": 0
                },
                "lessons": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "title",
                      "hours",
                      "practiceSessions",
                      "objectives"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1
                      },
                      "hours": {
                        "type": "number",
                        "minimum": 0
                      },
                      "practiceSessions": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "objectives": {
                        "type": "string"
                      }
                    }
                  }
                },
                "exercises": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "title",
                      "kind",
                      "support"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1
                      },
                      "kind": {
                        "type": "string",
                        "minLength": 1
                      },
                      "support": {
                        "enum": [
                          "RECIPE",
                          "FRAMEWORK",
                          "BRIEF"
                        ]
                      }
                    }
                  }
                },
                "checkItems": {
                  "type": "integer",
                  "minimum": 0
                },
                "safetyCheckItems": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "rubric": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "criterion",
                "competencies",
                "evidence",
                "weight"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "criterion": {
                  "type": "string",
                  "minLength": 1
                },
                "competencies": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "weight": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "competencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]{2}-[A-Z]{3,4}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
