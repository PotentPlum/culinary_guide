{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "facets.schema.json",
  "title": "Mise recipe facets (tag vocabulary)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "facets"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "facets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "nl", "options"],
        "properties": {
          "key": { "enum": ["cuisine", "dishType", "mainIngredient", "prepTime"] },
          "nl": { "type": "string", "minLength": 1 },
          "options": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "nl"],
              "properties": {
                "value": { "type": "string", "minLength": 1 },
                "nl": { "type": "string", "minLength": 1 },
                "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
              }
            }
          }
        }
      }
    }
  }
}
