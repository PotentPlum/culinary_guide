{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "disciplines.schema.json",
  "title": "Mise skill disciplines (profile radar axes, in display order)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "disciplines"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "disciplines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nl"],
        "properties": {
          "id": { "enum": ["mechanical", "thermal", "flavor", "material"] },
          "nl": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
