{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One curriculum course: introduction, lessons, exercises and knowledge-check items (generated by tools/export_curriculum.py)",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "introduction",
    "modules"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "enum": [
        1
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{3}-\\d$"
    },
    "introduction": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "note",
          "lessons",
          "exercises",
          "items"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]{3}-\\d\\.M\\d+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/block"
            }
          },
          "lessons": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "prerequisites",
                "competencies",
                "blocks"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}-\\d\\.M\\d+\\.L\\d+$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "prerequisites": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "competencies": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/competencyLevel"
                  }
                },
                "blocks": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/block"
                  }
                }
              }
            }
          },
          "exercises": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "description",
                "competencies",
                "blocks"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}-\\d\\.M\\d+\\.X\\d+$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                },
                "competencies": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/competencyLevel"
                  }
                },
                "blocks": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/block"
                  }
                }
              }
            }
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "type",
                "lessonId",
                "safety",
                "question",
                "options",
                "answer",
                "why"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}-\\d\\.M\\d+\\.Q\\d+$"
                },
                "type": {
                  "enum": [
                    "MULTIPLE_CHOICE",
                    "SCENARIO",
                    "CALCULATION",
                    "IMAGE_IDENTIFICATION",
                    "ORDERING"
                  ]
                },
                "lessonId": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}-\\d\\.M\\d+\\.L\\d+$"
                },
                "safety": {
                  "type": "boolean"
                },
                "question": {
                  "type": "string",
                  "minLength": 1
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "key",
                      "text"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "key": {
                        "type": "string",
                        "pattern": "^[A-F]$"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                "answer": {
                  "type": "string",
                  "minLength": 1
                },
                "why": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "block": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "paragraph"
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "list"
              ]
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "level",
                  "marker",
                  "text"
                ],
                "additionalProperties": false,
                "properties": {
                  "level": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2
                  },
                  "marker": {
                    "type": "string",
                    "pattern": "^(\\d+\\.)?$"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "header",
            "rows"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "table"
              ]
            },
            "header": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
    "competencyLevel": {
      "type": "object",
      "required": [
        "id",
        "level"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{2}-[A-Z]{3,4}$"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    }
  }
}
