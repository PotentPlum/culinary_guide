{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "archetypes.schema.json",
  "title": "Mise cooking archetypes (profile badges)",
  "description": "Journal badges as declarative rules (spec §12). 'techniques': at least minAttempts attempts contain a technique with the given discipline or one of techniqueIds, and (if minAvgScore) the mean of their non-null execution scores is >= minAvgScore. 'distinctPeakVegetables': at least min distinct vegetables cooked while at PEAK. 'peakMonths': at least min distinct calendar months (1-12) in which a vegetable was cooked while at PEAK.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "archetypes"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "archetypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nl",
          "description",
          "rule"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "nl": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "rule": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "discipline",
                  "minAttempts"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "techniques"
                    ]
                  },
                  "discipline": {
                    "enum": [
                      "mechanical",
                      "thermal",
                      "flavor"
                    ]
                  },
                  "minAttempts": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "minAvgScore": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 10
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "techniqueIds",
                  "minAttempts"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "techniques"
                    ]
                  },
                  "techniqueIds": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                    }
                  },
                  "minAttempts": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "minAvgScore": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 10
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "min"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "distinctPeakVegetables",
                      "peakMonths"
                    ]
                  },
                  "min": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
